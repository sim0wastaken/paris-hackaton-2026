# --- OpenAI ---
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5-mini
OPENAI_EXTRACTION_PROMPT_VERSION=2026-05-16

# --- Tavily (optional; intake falls back to manual text if absent) ---
TAVILY_API_KEY=

# --- fal.ai (optional; creative asset generation is skipped if absent) ---
FAL_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres

# --- Inngest (optional in local dev; required for serving in cloud) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Pioneer (post-v1, see Spec 10; not required for v1 demo) ---
PIONEER_API_KEY=

# --- Demo controls ---
DEMO_MODE=auto
ENABLE_DEMO_RESET=false
